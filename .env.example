# Configuration locale — préfixe SAW_ (backend/app/core/config.py).
# Aucune valeur secrète : l'outil est local strict (ADR-010).

# Service — l'API reste liée à la boucle locale.
SAW_HOST=127.0.0.1
SAW_PORT=8000
SAW_LOG_LEVEL=INFO

# Stockage — un fichier .sqlite par projet (ADR-001).
# Sous Windows, garder ce chemin court : au-delà d'environ 150 caractères,
# Quarto ne peut plus ouvrir ses fichiers de session et l'export est refusé.
# SAW_DATA_DIR=C:/Users/moi/.science-ai-writer

# LLM (ADR-003, ADR-014) — modèle unique persistant.
# Moteur : "lmstudio" (défaut) ou "ollama", indifféremment. Basculer ne
# demande que SAW_LLM_BACKEND : chaque moteur garde son propre identifiant de
# modèle, les identifiants ne passant pas d'un moteur à l'autre.
SAW_LLM_BACKEND=lmstudio

# LM Studio — serveur local à démarrer (lms server start).
SAW_LMSTUDIO_BASE_URL=http://127.0.0.1:1234
# ADR-015 : modèle 31B, déversement CPU/RAM assumé. Débit mesuré ~2,3 tokens/s.
SAW_LMSTUDIO_MODEL=google/gemma-4-31b
# Analogue de keep_alive=-1 : LM Studio n'accepte pas de durée infinie.
SAW_LMSTUDIO_TTL_SECONDS=86400

# Ollama — même modèle, sous l'identifiant d'Ollama (ollama pull gemma4:31b).
SAW_OLLAMA_BASE_URL=http://127.0.0.1:11434
SAW_OLLAMA_MODEL=gemma4:31b

# Second modèle réservé à l'agent code : refusé sous 12 Go de VRAM, et pour un
# moteur qui n'a pas d'identifiant de modèle de code.
SAW_CODE_MODEL_ENABLED=false
SAW_LMSTUDIO_CODE_MODEL=qwen/qwen3-coder-next
# SAW_OLLAMA_CODE_MODEL=

# Embeddings (ADR-013) — CPU, hors Ollama. Changer la dimension impose
# une réindexation complète du projet.
SAW_EMBEDDING_DIM=768
