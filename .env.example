# Configuration locale — préfixe SAW_ (backend/app/core/config.py).
# Aucune valeur secrète : l'outil est local strict (ADR-010).

# Service — l'API reste liée à la boucle locale.
SAW_HOST=127.0.0.1
SAW_PORT=8000
SAW_LOG_LEVEL=INFO

# Stockage — un fichier .sqlite par projet (ADR-001).
# SAW_DATA_DIR=C:/Users/moi/.science-ai-writer

# LLM (ADR-003, ADR-014) — modèle unique persistant.
# Moteur : "lmstudio" (défaut) ou "ollama". Changer de moteur impose de
# changer aussi SAW_LLM_MODEL : les identifiants ne sont pas interchangeables.
SAW_LLM_BACKEND=lmstudio
SAW_LMSTUDIO_BASE_URL=http://127.0.0.1:1234
SAW_LLM_MODEL=google/gemma-4-e4b
# Analogue de keep_alive=-1 : LM Studio n'accepte pas de durée infinie.
SAW_LMSTUDIO_TTL_SECONDS=86400

# Bascule vers Ollama :
#   SAW_LLM_BACKEND=ollama
#   SAW_OLLAMA_BASE_URL=http://127.0.0.1:11434
#   SAW_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# Second modèle réservé à l'agent code : refusé sous 12 Go de VRAM.
SAW_CODE_MODEL_ENABLED=false
SAW_CODE_MODEL=qwen/qwen3-coder-next

# Embeddings (ADR-013) — CPU, hors Ollama. Changer la dimension impose
# une réindexation complète du projet.
SAW_EMBEDDING_DIM=768
